classDiagram
    %% Working design: update in Phase 6 to match the final implementation.
    %% get_all_tasks returns (pet, task) pairs, preserving pet context.
    %% Plans are dictionaries; frequency is descriptive, not recurrence logic.

    class Task {
        +String task_id
        +String description
        +int duration_minutes
        +String frequency
        +String priority
        +bool completed
        +mark_complete() void
        +reset_completion() void
    }

    class Pet {
        +String name
        +int age_months
        +String species
        +List~String~ care_needs
        +List~Task~ tasks
        +add_task(task) void
        +edit_task(task_id, description, duration_minutes, frequency, priority) void
        +remove_task(task_id) void
        +update_care_needs(needs) void
    }

    class Owner {
        +String name
        +int available_minutes
        +Dictionary preferences
        +List~Pet~ pets
        +update_available_time(minutes) void
        +add_pet(pet) void
        +remove_pet(pet) void
        +update_preference(key, value) void
        +get_all_tasks() List
    }

    class Scheduler {
        +Owner owner
        +get_pending_tasks() List
        +sort_tasks(tasks) List
        +generate_plan(date) Dictionary
        +complete_task(task_id) void
    }

    Owner "1" o-- "0..*" Pet : cares for
    Pet "1" o-- "0..*" Task : has care tasks
    Scheduler --> Owner : retrieves tasks via get_all_tasks
    Scheduler ..> Task : sorts and completes
